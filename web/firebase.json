{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "/share/**",
        "destination": "/index.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      }
    ]
  }
}
